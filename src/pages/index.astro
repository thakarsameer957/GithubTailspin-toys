---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg sm:p-5" data-testid="filter-panel">
      <div class="mb-5 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-100">Filter games</h2>
          <p class="text-sm text-slate-400">Narrow the catalog by category, publisher, or both.</p>
        </div>
        <p class="text-xs text-slate-400">Select any combination of options.</p>
      </div>

        <div aria-label="Game filters" class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-end">
          <fieldset data-testid="category-filter" class="min-w-0">
            <legend class="mb-2 block text-sm font-semibold text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 hover:bg-slate-900 focus-within:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500">
                  <input
                    type="checkbox"
                    name="category"
                    value={String(category.id)}
                    data-testid="category-filter-option"
                    class="h-4 w-4 accent-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset data-testid="publisher-filter" class="min-w-0">
            <legend class="mb-2 block text-sm font-semibold text-slate-200">Publishers</legend>
            <div class="flex flex-wrap gap-2">
              {publishers.map((publisher) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 hover:bg-slate-900 focus-within:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500">
                  <input
                    type="checkbox"
                    name="publisher"
                    value={String(publisher.id)}
                    data-testid="publisher-filter-option"
                    class="h-4 w-4 accent-blue-500"
                  />
                  <span>{publisher.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="flex gap-2 lg:pb-0">
            <button
              type="button"
              data-testid="apply-filters-button"
              class="flex-1 whitespace-nowrap rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900 lg:flex-none"
            >
              Apply filters
            </button>
            <button
              type="button"
              data-testid="clear-filters-button"
              class="whitespace-nowrap rounded-lg border border-slate-600 bg-transparent px-3 py-2 font-medium text-blue-400 transition-colors hover:bg-slate-900 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
            >
              Clear filters
            </button>
          </div>
        </div>
    </div>

    <div>
      <p class="mb-4 text-sm text-slate-300" data-testid="active-filters" aria-live="polite">
        Showing all games
      </p>

      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => (
            <GameCard game={game} />
          ))}
        </div>
      )}

      <div data-testid="filter-empty-state" class="hidden">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>

  <script>
    const categoryOptions = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid="category-filter-option"]'));
    const publisherOptions = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid="publisher-filter-option"]'));
    const applyButton = document.querySelector<HTMLButtonElement>('[data-testid="apply-filters-button"]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters-button"]');
    const status = document.querySelector<HTMLElement>('[data-testid="active-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

    if (categoryOptions.length === 0 || publisherOptions.length === 0 || !applyButton || !clearButton || !status) {
      throw new Error('Filter controls are missing from the homepage.');
    }

    const safeStatus = status;

    function getSelectedValues(options: HTMLInputElement[]): number[] {
      return options.filter((option) => option.checked).map((option) => Number(option.value)).filter((value) => value > 0);
    }

    function updateStatus(selectedCategories: number[], selectedPublishers: number[]) {
      if (selectedCategories.length === 0 && selectedPublishers.length === 0) {
        safeStatus.textContent = 'Showing all games';
        return;
      }

      const labels: string[] = [];
      if (selectedCategories.length > 0) {
        labels.push(`${selectedCategories.length} category selection${selectedCategories.length > 1 ? 's' : ''}`);
      }
      if (selectedPublishers.length > 0) {
        labels.push(`${selectedPublishers.length} publisher selection${selectedPublishers.length > 1 ? 's' : ''}`);
      }
      safeStatus.textContent = `Showing matches for ${labels.join(' and ')}`;
    }

    function filterCards() {
      const selectedCategories = getSelectedValues(categoryOptions);
      const selectedPublishers = getSelectedValues(publisherOptions);
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCategoryId = Number(card.dataset.gameCategoryId || 0);
        const cardPublisherId = Number(card.dataset.gamePublisherId || 0);
        const categoryMatch = selectedCategories.length === 0 || selectedCategories.includes(cardCategoryId);
        const publisherMatch = selectedPublishers.length === 0 || selectedPublishers.includes(cardPublisherId);
        const isVisible = categoryMatch && publisherMatch;

        card.style.display = isVisible ? '' : 'none';
        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (gamesGrid) {
        gamesGrid.style.display = visibleCount === 0 ? 'none' : 'grid';
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0 || (selectedCategories.length === 0 && selectedPublishers.length === 0));
      }

      updateStatus(selectedCategories, selectedPublishers);
    }

    function resetFilters() {
      categoryOptions.forEach((option) => {
        option.checked = false;
      });
      publisherOptions.forEach((option) => {
        option.checked = false;
      });
      filterCards();
    }

    categoryOptions.forEach((option) => option.addEventListener('change', filterCards));
    publisherOptions.forEach((option) => option.addEventListener('change', filterCards));
    applyButton.addEventListener('click', filterCards);
    clearButton.addEventListener('click', resetFilters);
    filterCards();
  </script>
</Layout>
